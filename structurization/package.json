{
  "name": "pi-structurization",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./text-normalization": {
      "types": "./dist/text-normalization.d.ts",
      "default": "./dist/text-normalization.js"
    },
    "./scripts/export-lot-split-pdf.py": "./scripts/export-lot-split-pdf.py",
    "./compatibility": "./scripts/patch-pi-ai.mjs",
    "./internal/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/patch-pi-ai.mjs && tsc -p tsconfig.json && node scripts/copy-skills.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "postinstall": "node scripts/patch-pi-ai.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.10.0",
    "diff": "8.0.4",
    "jose": "6.2.12",
    "pdfjs-dist": "6.1.200",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@types/node": "22.19.19",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/better-sqlite3": "7.6.13"
  },
  "description": "Resumable acceptance extraction, catalog agents and template recognition built on Pi.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ryandong8282/pi-structurization.git",
    "directory": "structurization"
  },
  "files": [
    "dist",
    "scripts/export-lot-split-pdf.py",
    "scripts/patch-pi-ai.mjs",
    "README.md",
    "CHANGELOG.md",
    "src",
    "tsconfig.json"
  ]
}
